# Variáveis de Ambiente do Sistema MD Finanças (Vercel e Local)

# 1. Chave Secreta para integração com Atalhos do iOS (Header x-api-key)
GASTOS_API_KEY=sua_chave_secreta_aqui

# 2. Configurações do Supabase para persistência no servidor
SUPABASE_URL=https://bnhxmjcgyqwjombhrdks.supabase.co

# 3. Chave Service Role (Recomendado para Vercel ignorar RLS no backend)
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_do_supabase

# 4. Chave Pública Anon (Fallback)
SUPABASE_ANON_KEY=sua_chave_anon_do_supabase
